*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# OS Artifacts
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Logs & Runtime Dumps
*.log
npm-debug.log*
yarn-debug.log*
dev.log

# Build & Temporary Files
build/
dist/
*.tmp
*.bak

